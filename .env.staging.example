## Copy to .env (same directory) on the staging server, fill the four marked
## REQUIRED values, then `docker compose -f docker-compose.staging.yml up -d`.
## DO NOT commit .env — only this .example file ships to git.

# ─── REQUIRED — fill before first boot ──────────────────────────────────────

# Postgres password. Any strong string; the staging Postgres is only reachable
# from inside the compose network.
#   generate:  openssl rand -base64 24
POSTGRES_PASSWORD=

# JWT signing secret. HS384 (60 bytes), persisted across restarts. Rotating
# this invalidates every active session.
#   generate:  openssl rand -base64 60
JWT_SECRET=

# AES-GCM key for encrypting carrier credentials + CSRF secrets. 32 bytes
# base64. Rotating this makes every stored carrier password un-decryptable
# — regenerate ONLY on first install.
#   generate:  openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Public port the staging host listens on. Operators hit http://<host>:<port>.
# Any free port on the box; 8080 by default to match dev. 80 if you want it
# on the root URL (requires sudo for the Docker daemon to bind <1024).
STAGING_PORT=8080

# ─── Optional — override defaults ──────────────────────────────────────────

# Postgres DB name + user. Change ONLY if you need to match an existing dump.
# POSTGRES_DB=multiship_db
# POSTGRES_USER=postgres
