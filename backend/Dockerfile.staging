## Staging backend — multi-stage build from source.
## Build:  docker build -t shipai-backend:staging -f backend/Dockerfile.staging backend/
## Run:    docker compose -f docker-compose.staging.yml up -d backend
##
## Keeps the final image lean (JRE only, no Maven cache / build tooling) and
## bundles the zebrash native binaries that live under src/main/resources/
## zebrash-cli so ZPL → PDF/PNG rendering works out of the box.

FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
# Prime the dependency cache in a separate layer. Any pom change busts this;
# source-only edits reuse the warm cache.
RUN mvn -q -B dependency:go-offline
COPY src ./src
RUN mvn -q -B -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
# Install libc extras some native sidecars need (zebrash-cli for ARM/x86 both
# dynamic-link to glibc + libstdc++, present on temurin JRE images).
# curl is for the HEALTHCHECK below.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/*.jar /app/app.jar
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD curl -fsS http://localhost:8080/actuator/health/liveness || exit 1
# JVM tuning left minimal — staging box is small; adjust via JAVA_OPTS in .env
# if the server has <4GB RAM.
ENV JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError"
ENTRYPOINT ["sh","-c","exec java $JAVA_OPTS -jar /app/app.jar"]
