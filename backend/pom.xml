<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.multiship</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- PR #539 — zebrash-cli release binaries. Bump the tag to pull
		     a new build; the base-url composes to the GitHub release
		     asset root. Skip toggle lets offline builds pass without
		     the network hop (runtime ZebrashRenderer warns but doesn't
		     fail boot when the binary is missing). -->
		<zebrash.release.tag>zebrash-cli-v0.1.0</zebrash.release.tag>
		<zebrash.release.base-url>https://github.com/maharana2006-tech/thb-shioai/releases/download/${zebrash.release.tag}</zebrash.release.base-url>
		<zebrash.skip>false</zebrash.skip>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Sprint 49 Tier 1: Flyway for schema migrations. Baseline-on-migrate
		     lets Flyway stamp existing (ddl-auto-created) prod schemas at V1
		     without running the empty V1 file. V2+ contain real migrations. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<!-- Spring Boot 4 splits auto-configuration into modules; without this
		     one, flyway-core sits on the classpath but migrations never run. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>

		<!-- Sprint 49 Tier 3 Fix 6: Caffeine for bounded in-memory caches
		     (rate cache, tracking cache). Replaces plain ConcurrentHashMaps
		     that grew unbounded and evicted only on read. -->
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>

		<!-- Sprint 50 Tier 1 finding #7: Spring Data Redis powers the
		     Idempotency-Key replay store for the public v2 API. Also
		     lays groundwork for later per-tenant rate-limiter (Group E)
		     and Redis Streams webhook queue (Phase 2 of the plan). Lettuce
		     is the default connector — non-blocking, single-connection
		     multiplexed. Auto-disabled if spring.data.redis.host is unset,
		     so the unit-test suite (which doesn't start Redis) keeps
		     working without changes. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- Sprint 49 Tier 5 Fix 1: Testcontainers for real-Postgres
		     integration tests. Every test in the .integration package
		     is guarded by @EnabledIfEnvironmentVariable(INTEGRATION_TESTS=1)
		     so CI without Docker still runs the full unit suite green.
		     Version pinned explicitly — not in Spring Boot's BOM. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>1.20.4</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<version>1.20.4</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Sprint 40 — CSV + Excel order import. Apache Commons CSV for
             .csv parsing, Apache POI for .xlsx. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.11.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
        </dependency>

        <!-- Sprint 42 — Apache PDFBox for tenant-branded packing slip PDFs. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!-- Sprint 52 output routing — SFTP driver.
             mwiede/jsch is the actively-maintained fork of the original
             (abandoned) com.jcraft:jsch. Same package + API, so any
             existing docs / examples work; adds modern KEX + cipher
             algorithms that a current OpenSSH-based sftp server needs.
             Alternatives considered: Apache MINA sshd-sftp is a fuller
             SSH client but ~10x the dep footprint and we only need
             single-file upload. -->
        <dependency>
            <groupId>com.github.mwiede</groupId>
            <artifactId>jsch</artifactId>
            <version>0.2.21</version>
        </dependency>

        <!-- Sprint 51 BP-M4 — Actuator surfaces /actuator/health (K8s
             liveness+readiness probes) + /actuator/prometheus (metrics
             scrape). Micrometer Prometheus registry adapts every
             Micrometer meter (counters, timers, gauges) to the Prometheus
             text exposition format. Requires no code changes to appear;
             @Timed / Counter.builder() on hot paths add app-specific
             visibility on top of the JVM/HTTP defaults. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- @Timed uses Spring AOP (already transitive via
             spring-boot-starter-web). Pin the AspectJ runtime explicitly
             so a future starter split doesn't silently stop timing method
             invocations. Spring Boot 4 dropped the starter-aop shortcut;
             the plain aspectjrt + spring-aop from the parent BOM suffice. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aspects</artifactId>
        </dependency>
	</dependencies>

	<build>
		<!-- PR #539 — bundle zebrash-cli release binaries into the JAR under
		     native/{os}-{arch}/zebrash-cli[.exe]. The download-maven-plugin
		     block below fetches per-platform zips from the
		     zebrash-cli-v0.1.0 GitHub release into
		     target/generated-resources/zebrash/{slug}/; this extra
		     <resource> tells maven-resources-plugin to copy them into the
		     JAR at native/{slug}/. Runtime ZebrashRenderer extracts from
		     the classpath resource on first use. -->
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<resource>
				<directory>${project.build.directory}/generated-resources/zebrash</directory>
				<targetPath>native</targetPath>
				<filtering>false</filtering>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<id>cleanup-appledouble-files</id>
						<phase>validate</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>bash</executable>
							<arguments>
								<argument>${project.basedir}/scripts/cleanup-appledouble.sh</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- PR #539 — fetch per-platform zebrash-cli binaries from the
			     GitHub release into target/generated-resources/zebrash/{slug}/.
			     Bound to generate-resources (fires before the resources copy).
			     Caches by default so repeat clean-builds skip the network hop
			     if the artifact is already in ~/.m2/repository/.cache/. Version
			     bump = flip <zebrash.release.tag> below to pull new binaries.
			     Skip toggle: -Dzebrash.skip=true (e.g. offline builds; the
			     runtime service still boots, just logs the missing-binary
			     warning until the flag is enabled). -->
			<plugin>
				<groupId>com.googlecode.maven-download-plugin</groupId>
				<artifactId>download-maven-plugin</artifactId>
				<version>1.9.0</version>
				<executions>
					<execution>
						<id>zebrash-linux-amd64</id>
						<phase>generate-resources</phase>
						<goals><goal>wget</goal></goals>
						<configuration>
							<skip>${zebrash.skip}</skip>
							<url>${zebrash.release.base-url}/zebrash-cli-linux-amd64.zip</url>
							<outputDirectory>${project.build.directory}/generated-resources/zebrash/linux-amd64</outputDirectory>
							<unpack>true</unpack>
							<overwrite>false</overwrite>
						</configuration>
					</execution>
					<execution>
						<id>zebrash-linux-arm64</id>
						<phase>generate-resources</phase>
						<goals><goal>wget</goal></goals>
						<configuration>
							<skip>${zebrash.skip}</skip>
							<url>${zebrash.release.base-url}/zebrash-cli-linux-arm64.zip</url>
							<outputDirectory>${project.build.directory}/generated-resources/zebrash/linux-arm64</outputDirectory>
							<unpack>true</unpack>
							<overwrite>false</overwrite>
						</configuration>
					</execution>
					<execution>
						<id>zebrash-darwin-arm64</id>
						<phase>generate-resources</phase>
						<goals><goal>wget</goal></goals>
						<configuration>
							<skip>${zebrash.skip}</skip>
							<url>${zebrash.release.base-url}/zebrash-cli-darwin-arm64.zip</url>
							<outputDirectory>${project.build.directory}/generated-resources/zebrash/darwin-arm64</outputDirectory>
							<unpack>true</unpack>
							<overwrite>false</overwrite>
						</configuration>
					</execution>
					<execution>
						<id>zebrash-windows-amd64</id>
						<phase>generate-resources</phase>
						<goals><goal>wget</goal></goals>
						<configuration>
							<skip>${zebrash.skip}</skip>
							<url>${zebrash.release.base-url}/zebrash-cli-windows-amd64.zip</url>
							<outputDirectory>${project.build.directory}/generated-resources/zebrash/windows-amd64</outputDirectory>
							<unpack>true</unpack>
							<overwrite>false</overwrite>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
