## Staging frontend — Vite production build served by nginx inside the container.
## Build:  docker build -t shipai-frontend:staging -f multiship-react/Dockerfile.staging multiship-react/
## The outer nginx (nginx/staging.conf) reverse-proxies to this container on :80.

FROM node:20-alpine AS build
WORKDIR /src
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund --prefer-offline
COPY . .
# Build with the API base pointing at the same origin (/api/v1) because the
# outer nginx proxies /api/v1 to the backend container. See nginx/staging.conf.
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:1.27-alpine
# App-internal nginx — just serves the SPA bundle with the standard
# "index.html fallback for every non-asset path" rule React Router needs.
# The upstream /api/v1 proxy sits in the OUTER nginx (nginx/staging.conf).
RUN rm /etc/nginx/conf.d/default.conf
COPY <<'EOF' /etc/nginx/conf.d/spa.conf
server {
  listen 80 default_server;
  root /usr/share/nginx/html;
  index index.html;
  # Long-cache fingerprinted assets.
  location /assets/ {
    expires 30d;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }
  # SPA fallback — React Router owns every other path.
  location / {
    try_files $uri /index.html;
  }
}
EOF
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 80
