# Copy this file to `.env.local` for per-developer overrides. `.env.local`
# is git-ignored via multiship-react/.gitignore (`*.local`) so it won't
# accidentally leak your local config into a commit.
#
# All variables are read by Vite via loadEnv() in vite.config.ts.

# ─── Dev proxy target ────────────────────────────────────────────────────────
# Where Vite's dev server forwards /api/* calls. Default (if unset) is
# http://localhost:8081, matching backend/src/main/resources/application.properties
# (server.port=8081). Override if your backend runs elsewhere — e.g.
# Spring Boot's own default port 8080, or a remote sandbox.
#
# VITE_DEV_BACKEND_URL=http://localhost:8080

# ─── Production API base URL ─────────────────────────────────────────────────
# Required for `npm run build` (vite.config.ts throws if missing). Leave
# unset for `npm run dev` — the dev proxy above handles routing. In prod,
# either set to the deployed API origin OR to the literal "/api/v1" if the
# SPA is served from the same origin as the API (typical reverse-proxy
# layout).
#
# VITE_API_BASE_URL=/api/v1
