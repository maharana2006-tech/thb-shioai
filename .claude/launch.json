{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "multiship-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "multiship-react",
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort",
        "--host"
      ],
      "port": 5175
    },
    {
      "name": "multiship-web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "multiship-react",
        "run",
        "preview",
        "--",
        "--port",
        "5176",
        "--strictPort",
        "--host"
      ],
      "port": 5176
    },
    {
      "name": "dpd-mock",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/dpd-mock/server.mjs"
      ],
      "port": 8099
    }
  ]
}
